{
  "name": "vitalink-neuroguard",
  "version": "3.1.0",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "check": "node --check main.js && node --check renderer.js",
    "dist:win": "electron-builder --win nsis --x64",
    "test": "node --test tests/*.test.cjs",
    "verify": "npm run check && npm test"
  },
  "devDependencies": {
    "electron": "^33.4.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "org.vitalink.neuroguard",
    "productName": "VitaLink NeuroGuard",
    "files": ["main.js", "index.html", "renderer.js", "package.json"],
    "win": {"target": "nsis"},
    "directories": {"output": "dist"},
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
